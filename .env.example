# Copy to .env and fill in. Never commit .env -- it holds live credentials.

# --- Chat model ---------------------------------------------------------
# DEVELOPMENT runs against OpenAI directly, on the same gpt-5.4-mini model
# LLMod serves. The course budget is $13 TOTAL; spending it on development
# iterations leaves nothing for the graded runs.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_CHAT_MODEL=gpt-5.4-mini

# --- SUBMISSION: swap the three lines above for these ---
# LLM_API_KEY=<the group's LLMod key>
# LLM_BASE_URL=https://api.llmod.ai/v1
# LLM_CHAT_MODEL=MB5R2CF-azure/gpt-5.4-mini
#
# `GET /api/health` reports `chat_provider` and `submission_ready`. Check it
# before submitting: running on the wrong provider has no visible symptom --
# the agent answers just as well either way.

# --- Embedding model ----------------------------------------------------
# Pinned to LLMod even during development. The Pinecone index was built with
# THIS model; querying it with a different one still returns results, just
# meaningless ones. Do not let this follow the chat provider.
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_BASE_URL=https://api.llmod.ai/v1
LLM_EMBEDDING_MODEL=MB5R2CF-azure/text-embedding-3-small
LLM_REASONING_EFFORT=medium

# --- Pinecone (vector database) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=unipilot-wiki

# --- Supabase (primary database) ---
# The running agent reads through PostgREST over HTTPS with the anon key. That
# is stateless, so there is no connection pool for a serverless function to
# exhaust, no database password in the deployed environment, and no Postgres
# driver in the bundle.
#
# SUPABASE_URL is https://<project-ref>.supabase.co. The ref is also a claim
# inside the anon key, so the two cannot disagree unnoticed. The anon key is
# public by design -- it ships to browsers -- and is bound by Row Level Security.
SUPABASE_URL=
SUPABASE_KEY=

# --- SEEDING ONLY: never deploy either of these ---
# The service-role key bypasses Row Level Security; the DB URL is for DDL. They
# exist so the seed script can create and bulk-load tables, which the anon key
# deliberately cannot.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Budgets ---
# Vercel terminates any function call at 300s. Finish before it and ship what we
# have, rather than being killed mid-answer.
TIME_BUDGET_S=240
MAX_TURNS=8
